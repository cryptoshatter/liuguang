{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "流光",
  "version": "0.1.0",
  "identifier": "com.xiaohe.liuguang",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "流光",
        "width": 1440,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#F4F0E6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "category": "Productivity",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyQ0UzMUQyQzFEMzM5ODcKUldTSE9kUEIwakhPSXBwcTZoaDRlMTRKa1VuV1I1VFJiTVJPN0dDOXJueVRyOUxGY3ZqUG92QjYK",
      "endpoints": [
        "https://github.com/cryptoshatter/liuguang-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
